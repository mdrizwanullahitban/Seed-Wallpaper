<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="BackgroundBrush" Color="#071721"/>
 <SolidColorBrush x:Key="PanelBrush" Color="#102435"/>
 <SolidColorBrush x:Key="AccentBrush" Color="#45E0B2"/>
 <SolidColorBrush x:Key="TextBrush" Color="#EFF6FF"/>
 <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
  <GradientStop Color="#38E6A2" Offset="0"/><GradientStop Color="#259ED9" Offset=".52"/><GradientStop Color="#8A42EE" Offset="1"/>
 </LinearGradientBrush>
 <Style TargetType="Button">
  <Setter Property="Background" Value="#193247"/><Setter Property="Foreground" Value="#EAF4FF"/>
  <Setter Property="BorderBrush" Value="#29465B"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,0,9"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value=".83"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value=".45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Height" Value="46"/>
  <Setter Property="Padding" Value="14,0"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Margin" Value="0,0,0,5"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Button">
    <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="10"
      Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
     <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
       RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="NavSurface" Property="Background" Value="#1B3747"/>
     </Trigger>
     <Trigger Property="IsPressed" Value="True">
      <Setter TargetName="NavSurface" Property="Opacity" Value="0.75"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBoxItem">
  <Setter Property="Margin" Value="0,0,10,12"/><Setter Property="Padding" Value="4"/>
  <Setter Property="Background" Value="#142C3C"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="Card" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="5">
    <ContentPresenter/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#43E0B4"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#39769D"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SeedScrollBar" TargetType="{x:Type ScrollBar}">
  <Setter Property="Width" Value="12"/>
  <Setter Property="MinWidth" Value="12"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type ScrollBar}">
     <Grid Background="Transparent" Width="12">
      <Border Width="4" HorizontalAlignment="Center" Background="#193546" CornerRadius="3" Margin="0,5"/>
      <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
       <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb MinHeight="36" Cursor="Hand">
         <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
           <Border x:Name="Grip" Width="7" HorizontalAlignment="Center" Background="#4D8898" CornerRadius="4" Margin="0,3"/>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#65E0C2"/><Setter TargetName="Grip" Property="Width" Value="9"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#75F0D1"/></Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Thumb.Template>
        </Thumb>
       </Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track>
     </Grid>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SeedScrollBar}"/>
</ResourceDictionary>