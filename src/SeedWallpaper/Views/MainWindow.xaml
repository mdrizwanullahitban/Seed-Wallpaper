<Window x:Class="SeedWallpaper.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Seed Wallpaper" Width="1100" Height="720" MinWidth="800" MinHeight="520"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
 Foreground="{StaticResource TextBrush}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#17271D" Padding="20">
   <StackPanel>
    <TextBlock Text="🌱 Seed" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
    <TextBlock Text="WALLPAPER" Foreground="#9CB6A0" FontSize="11" Margin="5,0,0,38"/>
    <Button Content="Home" Click="Home_Click"/>
    <Button Content="Discover" Click="Discover_Click"/>
    <Button Content="Seed Studio" Click="Studio_Click"/>
    <Button Content="My Garden" Click="Garden_Click"/>
    <Button Content="Settings" Click="Settings_Click"/>
   </StackPanel>
  </Border>
  <Grid Grid.Column="1" Margin="25">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Grow your desktop." FontSize="29" FontWeight="SemiBold" Margin="0,0,0,18"/>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,14,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top">
       <TextBlock x:Name="PageTitle" Text="My Garden" FontSize="23" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
       <TextBlock x:Name="PageDescription" Text="Your locally saved wallpapers." Foreground="#B8CDBB" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <Button x:Name="ImportButton" Content="Import image" Click="Import_Click"/>
       <Button x:Name="RefreshButton" Content="Refresh gallery" Click="Refresh_Click"/>
      </StackPanel>
      <ListBox x:Name="GalleryList" Background="Transparent" BorderThickness="0"
       Foreground="White" SelectionChanged="Gallery_SelectionChanged">
       <ListBox.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,0,0,12">
         <Image Source="{Binding}" Height="115" Stretch="Uniform"/>
         <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
        </StackPanel>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14">
     <StackPanel>
      <TextBlock Text="Preview" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Border Background="#102019" Height="190"><Image x:Name="PreviewImage" Stretch="Uniform"/></Border>
      <TextBlock x:Name="SelectedText" Text="Choose an image to preview" TextWrapping="Wrap" Margin="0,14,0,14"/>
      <Button x:Name="ApplyButton" Content="Apply Wallpaper" Click="Apply_Click"/>
      <TextBlock Text="Lock-screen choices open Windows Settings; direct lock-screen application is not yet supported." FontSize="11" Foreground="#B8CDBB" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
   <TextBlock x:Name="StatusText" Grid.Row="2" Text="Phase 2 • Local wallpapers" Foreground="#A5C6AC" Margin="0,15,0,0"/>
  </Grid>
 </Grid>
</Window>