<Window x:Class="SeedWallpaper.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Seed Wallpaper" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Width="1320" Height="820" MinWidth="1020" MinHeight="610"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
 FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <Grid>
  <Grid.RowDefinitions><RowDefinition x:Name="TitleBarRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#091C28" BorderBrush="#19354B" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,28,14,24">

    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Viewbox Width="32" Height="37" Margin="0,0,10,0" Stretch="Uniform">
       <Canvas Width="40" Height="44">
        <Path Data="M 19,39 C 8,34 9,23 18,19 C 26,17 33,23 30,32 C 28,38 24,40 19,39 Z" Fill="#63E4BA"/>
        <Path Data="M 20,24 C 21,15 23,11 27,8" Stroke="#D7FFE9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M 24,14 C 17,13 12,9 11,4 C 18,4 23,7 24,14 Z" Fill="#46D9A4"/>
        <Path Data="M 24,14 C 26,7 32,4 38,5 C 36,12 30,15 24,14 Z" Fill="#8AF1C3"/>
        <Path Data="M 19,31 C 21,34 24,35 26,33" Stroke="#0B5647" StrokeThickness="1.6" StrokeEndLineCap="Round" Fill="Transparent"/>
       </Canvas>
      </Viewbox>
      <TextBlock Text="Seed" FontSize="31" FontWeight="Bold" Foreground="#63E4BA" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock Text="W A L L P A P E R" Foreground="#A8C5D3" FontSize="10" Margin="13,0,0,48"/>
     <Button x:Name="HomeButton" Style="{StaticResource NavButton}" Content="⌂    Home" Click="Home_Click"/>
     <Button x:Name="DiscoverButton" Style="{StaticResource NavButton}" Content="◈    Discover" Click="Discover_Click"/>
     <Button x:Name="StudioButton" Style="{StaticResource NavButton}" Content="✧    Seed Studio" Click="Studio_Click"/>
     <Button x:Name="GardenButton" Style="{StaticResource NavButton}" Content="♡    My Garden" Click="Garden_Click"/>
     <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Content="⚙    Settings" Click="Settings_Click"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,24,26,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="TopSearchBar" Margin="0,0,0,24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#173247" BorderBrush="#25475B" BorderThickness="1" CornerRadius="12" Height="46" MaxWidth="700" HorizontalAlignment="Stretch">
     <DockPanel Margin="15,0"><TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="25" Foreground="#91B8CB" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Background="Transparent" Foreground="#F0F8FF" BorderThickness="0"
       CaretBrush="#53E7BB" VerticalContentAlignment="Center" FontSize="14" ToolTip="Search online in Discover, or filter filenames in My Garden" KeyDown="Search_KeyDown"/>
     </DockPanel>
    </Border>
    <TextBlock Grid.Column="1" Text="SEED  /  WALLPAPER" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#86A8BB" FontSize="12"/>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="300"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="GalleryScroll" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False">
    <Grid x:Name="GalleryWorkspace">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,4,0,24">
      <TextBlock x:Name="PageTitle" Text="My Garden" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock x:Name="PageDescription" Text="Your personal collection of wallpapers." Foreground="#9EB7C8" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel x:Name="CategoryBar" Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="EXPLORE COLLECTIONS" Foreground="#90B7C9" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <WrapPanel>
       <Button Tag="nature landscape" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Nature wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🌿" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Nature" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="astronomy nebula" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Space wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🌌" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Space" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="sports car" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Cars wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🏎" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Cars" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="city skyline" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Cityscapes wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🏙" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Cityscapes" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="ocean underwater" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Seascapes wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🌊" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Seascapes" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="painting colorful" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Art wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🎨" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Art" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="geometric abstract" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Geometric wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🔷" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Geometric" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="wildlife photography" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Wildlife wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🐾" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Wildlife" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="architecture building" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Architecture wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🏛" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Architecture" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="planet earth" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Earth wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🌍" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Earth" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="science fiction" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Sci-Fi wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🪐" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Sci-Fi" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button Tag="mountain landscape" Click="Category_Click" Width="136" Height="115" Margin="0,0,9,9" Padding="4" Background="#173448" BorderBrush="#2C5365" BorderThickness="1" ToolTip="Browse Landscapes wallpapers">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="🏔" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,8"/>
         <TextBlock Text="Landscapes" FontSize="13" FontWeight="SemiBold" Foreground="#E3F3FC" HorizontalAlignment="Center"/>
        </StackPanel>
       </Button>
      </WrapPanel>
     </StackPanel>
     <Grid Grid.Row="2" Margin="0,0,0,15">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="GalleryHeading" Text="Wallpapers" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button x:Name="RecentButton" Grid.Column="1" Content="Recently Used" Click="Recent_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
      <Button x:Name="MoreButton" Grid.Column="2" Content="Load More" Click="More_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
      <Button x:Name="RefreshButton" Grid.Column="2" Content="↻  Refresh" Click="Refresh_Click" Margin="0,0,10,0"/>
      <Button x:Name="OpenFolderButton" Grid.Column="3" Content="Open Folder" Click="OpenFolder_Click" Margin="0,0,10,0"/>
      <Button x:Name="ImportButton" Grid.Column="4" Click="Import_Click" BorderThickness="0" Background="{StaticResource AccentGradient}" Foreground="#071824" FontWeight="SemiBold" Content="+  Import Images" Margin="0"/>
     </Grid>
     <Border Grid.Row="3" Background="#0C202E" BorderBrush="#1B3B50" BorderThickness="1" CornerRadius="16" Padding="12">
      <Grid>
       <TextBlock x:Name="EmptyHint" Text="Your garden is waiting.&#10;Import your first wallpaper to begin."
        Foreground="#88A9BC" TextAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
       <ListBox x:Name="OnlineList" PreviewMouseWheel="GalleryList_PreviewMouseWheel" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="White"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="Online_SelectionChanged" PreviewMouseRightButtonDown="WallpaperList_RightClick">
        <ListBox.ContextMenu><ContextMenu><MenuItem Header="Apply as desktop wallpaper" Click="OnlineContextApply_Click"/><MenuItem Header="Download to My Garden" Click="OnlineContextDownload_Click"/></ContextMenu></ListBox.ContextMenu>
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate>
         <StackPanel Width="174">
          <Border CornerRadius="9" ClipToBounds="True" Background="#091721" Height="116">
           <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" />
          </Border>
          <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="3,8,3,3" Foreground="#DDEDF7"/>
          <TextBlock Text="{Binding License}" FontSize="10" Foreground="#9DC1CE" Margin="3,0,3,2"/>
         </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <ListBox x:Name="GalleryList" PreviewMouseWheel="GalleryList_PreviewMouseWheel" Background="Transparent" BorderThickness="0" Foreground="White"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="Gallery_SelectionChanged" PreviewMouseRightButtonDown="WallpaperList_RightClick">
        <ListBox.ContextMenu><ContextMenu><MenuItem Header="Apply as desktop wallpaper" Click="GardenContextApply_Click"/></ContextMenu></ListBox.ContextMenu>
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate>
         <StackPanel Width="174">
          <Border CornerRadius="9" ClipToBounds="True" Background="#091721" Height="116">
           <Image Source="{Binding}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" />
          </Border>
          <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="3,8,3,3" Foreground="#DDEDF7"/>
         </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Border>
    </Grid>
    </ScrollViewer>
    <Border x:Name="ShortcutSettingsPanel" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#0C1D2B" CornerRadius="16" Padding="32">
     <StackPanel HorizontalAlignment="Left" Width="620">
      <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Foreground="#EFF6FF"/>
      <TextBlock Text="Personalise how you use Seed Wallpaper." Foreground="#9EB7C8" Margin="0,8,0,30"/>
      <Border Background="#142C3C" CornerRadius="14" Padding="24" BorderBrush="#29465B" BorderThickness="1">
       <StackPanel>
        <TextBlock Text="⌨  KEYBOARD SHORTCUTS" Foreground="#64DDBA" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,20"/>
        <Grid Margin="0,0,0,16">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="Toggle fullscreen" Foreground="#EFF6FF" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="Enter or exit fullscreen mode" Foreground="#9EB7C8" FontSize="12" Margin="0,5,0,0"/>
         </StackPanel>
         <Border Grid.Column="1" Background="#234459" CornerRadius="8" Padding="14,9">
          <TextBlock Text="Alt + Enter" Foreground="#C7F5E6" FontWeight="SemiBold"/>
         </Border>
        </Grid>
        <Separator Background="#2B4B5C" Margin="0,0,0,16"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="Close Seed Wallpaper" Foreground="#EFF6FF" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="Immediately exit the application" Foreground="#9EB7C8" FontSize="12" Margin="0,5,0,0"/>
         </StackPanel>
         <Border Grid.Column="1" Background="#234459" CornerRadius="8" Padding="14,9">
          <TextBlock Text="Alt + Backspace" Foreground="#C7F5E6" FontWeight="SemiBold"/>
         </Border>
        </Grid>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>
    <Border x:Name="GoogleDiscoverPanel" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#0C0E15" BorderBrush="#303748" BorderThickness="1" CornerRadius="14">
     <DockPanel>
      <Grid Background="#0C0E15">
       <TextBlock x:Name="GoogleLoadingText" Text="Loading Google Images…" Foreground="#A9BECD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <wv2:WebView2 x:Name="GoogleDiscoverBrowser" Visibility="Hidden" NavigationStarting="GoogleNavigationStarting" NavigationCompleted="GoogleNavigationCompleted"/>
      </Grid>
     </DockPanel>
    </Border>
    <Border x:Name="PerchanceStudioPanel" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#0C0E15" CornerRadius="14" BorderBrush="#303748" BorderThickness="1">
     <DockPanel>
      <Border DockPanel.Dock="Top" Background="#171B26" Padding="12" CornerRadius="12,12,0,0">
       <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button Content="Reload" Click="PerchanceReload_Click" Margin="0,0,8,0" Padding="14,7"/>
         <Button Content="Open in browser" Click="PerchanceOpen_Click" Padding="14,7"/>
        </StackPanel>
        <StackPanel>
         <TextBlock Text="Seed Studio · Perchance" FontSize="17" FontWeight="SemiBold" Foreground="#E9F4FA"/>
         <TextBlock Text="Free image generation powered by the Perchance website. Download images to your PC, then import them into My Garden." FontSize="11" Foreground="#A8B8C8" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Grid Background="#0C0E15">
       <TextBlock x:Name="PerchanceLoadingText" Text="Loading Perchance image generator…" Foreground="#A9BECD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <wv2:WebView2 x:Name="PerchanceBrowser" NavigationCompleted="PerchanceNavigationCompleted"/>
      </Grid>
     </DockPanel>
    </Border>
    <Grid x:Name="StudioPanel" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#0C0E15">
     <Grid.ColumnDefinitions><ColumnDefinition Width="420" MinWidth="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="#171B26" BorderBrush="#303748" BorderThickness="1" CornerRadius="16" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="CONTROL CENTER" Foreground="#72D8C0" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
        <TextBlock Text="Create your wallpaper" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <TextBlock Text="GENERATION MODE" Foreground="#A9B6CB" FontSize="11" Margin="0,0,0,7"/>
        <ComboBox x:Name="StudioMode" SelectionChanged="StudioMode_Changed" SelectedIndex="0" Margin="0,0,0,16">
         <ComboBoxItem Content="Text to Image" Tag="t2i"/>
         <ComboBoxItem Content="Image to Image (coming with local backend)" Tag="i2i"/>
        </ComboBox>
        <StackPanel x:Name="StudioReferencePanel" Visibility="Collapsed" Margin="0,0,0,14">
         <TextBlock Text="REFERENCE IMAGE" Foreground="#A9B6CB" FontSize="11" Margin="0,0,0,7"/>
         <Button Content="Choose reference image…" Click="StudioReference_Click"/>
         <TextBlock x:Name="StudioReferenceLabel" Text="No image selected" Foreground="#9BAABD" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Text="AI MODEL" Foreground="#A9B6CB" FontSize="11" Margin="0,0,0,7"/>
        <ComboBox x:Name="StudioModel" SelectedIndex="0" SelectionChanged="StudioModel_Changed" Margin="0,0,0,9">
         <ComboBoxItem Content="Flux · Pollinations" Tag="flux"/>
         <ComboBoxItem Content="Z-Image · Pollinations" Tag="zimage"/>
         <ComboBoxItem Content="Custom Pollinations model…" Tag="custom"/>
        </ComboBox>
        <TextBlock x:Name="StudioModelDescription" Text="Cloud model · Pollinations API key required" Foreground="#91A7BB" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel x:Name="StudioCustomModelPanel" Visibility="Collapsed" Margin="0,0,0,12">
         <TextBlock Text="CUSTOM MODEL ID" Foreground="#A9B6CB" FontSize="11" Margin="0,0,0,6"/>
         <TextBox x:Name="StudioCustomModel" Padding="9" Background="#252B39" Foreground="White"/>
        </StackPanel>
        <TextBlock Text="PROMPT" Foreground="#A9B6CB" FontSize="11" Margin="0,0,0,7"/>
        <TextBox x:Name="StudioPrompt" Height="104" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="12" Background="#252B39" Foreground="White" Text="Cinematic mountain landscape at sunrise, soft fog, natural colours, detailed wallpaper"/>
        <Button Content="✦ Auto-enhance prompt" Click="StudioEnhance_Click" HorizontalAlignment="Left" Margin="0,8,0,14"/>
        <TextBlock Text="NEGATIVE PROMPT (supported models only)" Foreground="#A9B6CB" FontSize="11" Margin="0,0,0,7"/>
        <TextBox x:Name="StudioNegativePrompt" Height="56" AcceptsReturn="True" TextWrapping="Wrap" Padding="10" Background="#252B39" Foreground="White" Text="blurry, low quality, watermark"/>
        <TextBlock Text="WALLPAPER SIZE" Foreground="#A9B6CB" FontSize="11" Margin="12,10,0,7"/>
        <ComboBox x:Name="StudioResolution" SelectedIndex="0" Margin="0,0,0,12">
         <ComboBoxItem Content="16:9 · 1920 × 1080" Tag="1920x1080"/>
         <ComboBoxItem Content="16:9 · 1280 × 720" Tag="1280x720"/>
         <ComboBoxItem Content="21:9 · 1792 × 768" Tag="1792x768"/>
         <ComboBoxItem Content="32:9 · 1920 × 540" Tag="1920x540"/>
         <ComboBoxItem Content="Portrait · 1024 × 1536" Tag="1024x1536"/>
        </ComboBox>
        <Expander Header="Advanced parameters" Foreground="#E8F1FA" Margin="0,0,0,15">
         <StackPanel Margin="8,12">
          <TextBlock Text="Guidance scale (backend dependent)" Foreground="#A9B6CB"/>
          <Slider x:Name="StudioGuidance" Minimum="1" Maximum="20" Value="7" TickFrequency="1"/>
          <TextBlock Text="Denoising strength (image-to-image only)" Foreground="#A9B6CB" Margin="0,12,0,0"/>
          <Slider x:Name="StudioDenoising" Minimum="0" Maximum="1" Value="0.65"/>
          <TextBlock Text="Seed number" Foreground="#A9B6CB" Margin="0,12,0,5"/>
          <DockPanel>
           <Button DockPanel.Dock="Right" Content="Randomise" Click="StudioRandomSeed_Click" Margin="8,0,0,0"/>
           <TextBox x:Name="StudioSeed" Text="42" Background="#252B39" Foreground="White" Padding="9"/>
          </DockPanel>
          <TextBlock Text="CFG, negative prompt and denoising are not sent to the current Pollinations endpoint." Foreground="#91A7BB" TextWrapping="Wrap" Margin="0,8,0,0"/>
         </StackPanel>
        </Expander>
        <TextBlock Text="POLLINATIONS API KEY" Foreground="#A9B6CB" FontSize="11" Margin="0,0,0,7"/>
        <PasswordBox x:Name="StudioKey" Height="40" Padding="9" Background="#252B39" Foreground="White" Margin="0,0,0,7"/>
        <TextBlock Text="Key stays in app memory; cloud generation may cost credits." Foreground="#91A7BB" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,13"/>
        <Button x:Name="StudioGenerate" Content="✦ Generate wallpaper" Click="StudioGenerate_Click" Background="#287A7E" Foreground="White" FontWeight="SemiBold" Padding="16,14"/>
        <TextBlock x:Name="StudioStatus" Text="Ready to generate." Foreground="#B3C7D5" TextWrapping="Wrap" Margin="0,9,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
     <Border Grid.Column="2" Background="#171B26" BorderBrush="#303748" BorderThickness="1" CornerRadius="16" Padding="18">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <TextBlock Text="Live Desktop Preview" FontSize="21" FontWeight="SemiBold"/>
        <CheckBox x:Name="StudioOverlayToggle" Content="Show Windows desktop overlay" IsChecked="True" Checked="StudioOverlay_Changed" Unchecked="StudioOverlay_Changed" Margin="0,12,0,0"/>
       </StackPanel>
       <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
        <Button x:Name="StudioApply" Content="Set as Active Windows Wallpaper" Click="StudioApply_Click" IsEnabled="False" Background="#287A7E" Foreground="White" Padding="14,12"/>
        <Button x:Name="StudioOpenGarden" Content="Open in My Garden" Click="StudioOpenGarden_Click" IsEnabled="False" Margin="0,8,0,0"/>
       </StackPanel>
       <Grid Background="#090D15" ClipToBounds="True">
        <Image x:Name="StudioResult" Stretch="Uniform"/>
        <TextBlock x:Name="StudioPreviewHint" Text="Your generated wallpaper will appear here" Foreground="#8495AD" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        <Grid x:Name="StudioDesktopOverlay" IsHitTestVisible="False">
         <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
          <TextBlock Text="▣" Foreground="White" FontSize="25"/>
          <TextBlock Text="This PC" Foreground="White" FontSize="11"/>
         </StackPanel>
         <Border VerticalAlignment="Bottom" Height="44" Background="#D21B2231">
          <Grid>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="⊞" FontSize="24" Foreground="White" Margin="0,0,15,0"/>
            <TextBlock Text="⌕" FontSize="22" Foreground="White" Margin="0,0,15,0"/>
            <TextBlock Text="▣" FontSize="20" Foreground="White"/>
           </StackPanel>
           <TextBlock x:Name="StudioClock" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
          </Grid>
         </Border>
        </Grid>
       </Grid>
      </DockPanel>
     </Border>
    </Grid>
    <Border x:Name="WallpaperDetailsPanel" Grid.Column="1" Background="#102636" BorderBrush="#24445C" BorderThickness="1" CornerRadius="18" Padding="16">
     <StackPanel>
      <Border Height="220" Background="#091B28" CornerRadius="12" ClipToBounds="True">
       <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
      </Border>
      <TextBlock x:Name="SelectedText" Text="Select a wallpaper" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,7"/>
      <TextBlock Text="Your desktop, your atmosphere." Foreground="#90AFC0" FontSize="12" Margin="0,0,0,22"/>
      <Button x:Name="BrowseButton" Content="Browse Online Wallpapers" Click="Browse_Click" Visibility="Collapsed" Background="{StaticResource AccentGradient}" Foreground="#FFFFFF" BorderThickness="0" Padding="12,15"/>
      <Button x:Name="DownloadButton" Content="Save to My Garden" Click="Download_Click" Visibility="Collapsed"/>
      <Button x:Name="SourceButton" Content="View Source &amp; Licence" Click="Source_Click" Visibility="Collapsed"/>
      <TextBlock x:Name="CreditText" Foreground="#9CB9C9" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12" Visibility="Collapsed"/>
      <Button x:Name="ApplyButton" Background="{StaticResource AccentGradient}" Foreground="#FFFFFF" BorderThickness="0"
       FontWeight="SemiBold" FontSize="15" Content="▣  Apply Wallpaper" Click="Apply_Click" Padding="12,15"/>
      <Button x:Name="FavoriteButton" Content="♡  Add to Favourites" Click="Favorite_Click"/>
      <Button x:Name="DeleteButton" Content="Remove from My Garden" Click="Delete_Click"/>
      <Separator Background="#2B4B5C" Margin="0,12,0,12"/>
      <TextBlock Text="HOW IT WORKS" Foreground="#8FB0C2" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock Text="1. Import an image&#10;2. Select it in the gallery&#10;3. Choose desktop and fit options"
       Foreground="#C1D5E0" FontSize="13" LineHeight="26"/>
      <TextBlock Text="Lock screen uses Windows Settings." Foreground="#829FAF" FontSize="11" Margin="0,25,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </Grid>
   <Border x:Name="OfflinePanel" Grid.Row="1" Panel.ZIndex="50" Background="#091C28" CornerRadius="16" Visibility="Collapsed">
    <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Border Width="108" Height="108" CornerRadius="54" Background="#153440" HorizontalAlignment="Center" Margin="0,0,0,24">
      <TextBlock Text="⌁" FontSize="70" Foreground="#62DCC2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="You're offline" FontSize="30" FontWeight="Bold" Foreground="#F0F7FA" HorizontalAlignment="Center"/>
     <TextBlock Text="Seed Wallpaper couldn't reach the internet. Check your Wi-Fi or Ethernet connection and try again." Foreground="#A5BDCB" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,24" FontSize="14"/>
     <Border Background="#112F3B" CornerRadius="12" Padding="16" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="▣" FontSize="26" Foreground="#6DB3B5" Margin="0,0,14,0"/>
       <StackPanel>
        <TextBlock Text="Connection unavailable" FontWeight="SemiBold" Foreground="#DDECF1"/>
        <TextBlock Text="Online content needs internet access." Foreground="#A5BDCB" FontSize="12" Margin="0,5,0,0"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="↻  Retry Connection" Click="OfflineRetry_Click" Background="#35CDA6" Foreground="#071B25" FontWeight="SemiBold" Padding="20,13" Margin="0,0,12,0"/>
      <Button Content="⚙  Check Connection" Click="OfflineSettings_Click" Padding="20,13" Margin="0"/>
     </StackPanel>
     <TextBlock Text="My Garden and Settings work offline." Foreground="#789EAD" FontSize="12" HorizontalAlignment="Center" Margin="0,20,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock x:Name="StatusText" Visibility="Collapsed" Grid.Row="2" Text="Seed Wallpaper  •  Local collection" Foreground="#87A9BA" Margin="0,15,0,0" FontSize="12"/>
  </Grid>
 </Grid>
 </Grid>
</Window>