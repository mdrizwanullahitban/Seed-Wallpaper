<Window x:Class="SeedWallpaper.Views.ApplyWallpaperDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Apply wallpaper" Width="390" Height="300" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#17271D" Foreground="White">
 <StackPanel Margin="24">
  <TextBlock Text="Where should it grow?" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/>
  <RadioButton x:Name="DesktopRadio" Content="Desktop" IsChecked="True" Margin="0,0,0,10"/>
  <RadioButton x:Name="LockRadio" Content="Lock screen (Windows Settings)" Margin="0,0,0,10"/>
  <RadioButton x:Name="BothRadio" Content="Both (desktop + Windows Settings)" Margin="0,0,0,14"/>
  <TextBlock Text="Desktop image placement" Foreground="#B8CDBB" Margin="0,0,0,6"/>
  <ComboBox x:Name="FitBox" SelectedIndex="0" Height="30" Margin="0,0,0,14">
   <ComboBoxItem Content="Fill"/><ComboBoxItem Content="Fit"/><ComboBoxItem Content="Stretch"/>
   <ComboBoxItem Content="Center"/><ComboBoxItem Content="Tile"/><ComboBoxItem Content="Span"/>
  </ComboBox>
  <Button Content="Continue" Click="Continue_Click"/>
 </StackPanel>
</Window>